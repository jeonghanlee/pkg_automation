function printf_tee {
    local input="${1:-}"
    local target="${2:-}"
    local parent
    local tmp
    local rc=0

    if [[ -z "${target}" || "${target}" != /* ]]; then
        printf "printf_tee: absolute target path required\n" >&2
        return 1
    fi
    if [[ -L "${target}" ]]; then
        printf "printf_tee: refusing to write through symlink: %s\n" "${target}" >&2
        return 1
    fi
    if [[ -e "${target}" && ! -f "${target}" ]]; then
        printf "printf_tee: target exists and is not a regular file: %s\n" "${target}" >&2
        return 1
    fi
    parent="$(dirname -- "${target}")"
    if [[ ! -d "${parent}" || -L "${parent}" ]]; then
        printf "printf_tee: parent directory missing or symlink: %s\n" "${parent}" >&2
        return 1
    fi

    tmp="$(${SUDO_CMD} mktemp -- "${parent}/.printf_tee.XXXXXXXX")" || return 1
    if ! printf "%s" "${input}" | ${SUDO_CMD} tee -- "${tmp}" >/dev/null; then
        rc=1
    fi
    if (( rc == 0 )) && ! ${SUDO_CMD} chmod 0644 -- "${tmp}"; then
        rc=1
    fi
    if (( rc == 0 )) && ! ${SUDO_CMD} mv -- "${tmp}" "${target}"; then
        rc=1
    fi
    if (( rc != 0 )); then
        ${SUDO_CMD} rm -f -- "${tmp}"
    fi
    return "${rc}"
}


