function execute_cmd {
    local isVar

    isVar=$(checkIfVar "${1:-}")
    
    if [[ $isVar -eq "$NON_EXIST" ]]; then
	printf "Any input command is needed!\n"
	return 1
    fi
    "$@"
    printf "\n"
}


function compare_strs {
   
    local str1=$1
    local str2=$2
    local result=""
    
    if [ "$str1" = "$str2" ]
    then
	# yes, it is the same, 
	result=$EXIST
    else
        # no
	result=$NON_EXIST
    fi
    printf "%s\n" "${result}"
}



